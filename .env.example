# ElevenLabs (Jax SFX / voice generators — never commit the real key)
ELEVENLABS_API_KEY=

# Cloudflare R2 bucket name for toon media (upload-r2-assets.js)
R2_BUCKET=twentyseven-assets

# Optional CDN origin for toon images / audio at build time.
# Empty or unset = same-origin from Cloudflare Pages (public/).
# After R2 custom domain is live:
# VITE_ASSET_BASE=https://assets.twentyseven.pictures
# Local CDN preview (r2.dev — public bucket URL):
# VITE_ASSET_BASE=https://pub-e60c8fa8eea343fbac708bf75981d19c.r2.dev
VITE_ASSET_BASE=

# Protected local preview (make local / make local-cdn / make dev-protected)
# Server binds 127.0.0.1 only. Basic-auth credentials:
PREVIEW_USER=dev
PREVIEW_PASS=
# Leave PREVIEW_PASS empty for make local → random password printed at start.
# For make dev-protected, default pass is "dev" if unset.
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4173
