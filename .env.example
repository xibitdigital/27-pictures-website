# ElevenLabs (Jax SFX / voice — never commit the real key)
ELEVENLABS_API_KEY=

# Cloudflare R2
R2_BUCKET=twentyseven-assets

# REQUIRED for production builds and deploys (media is not in git).
# Vite fails `npm run build` if this is empty.
# Temporary public bucket URL:
VITE_ASSET_BASE=https://pub-e60c8fa8eea343fbac708bf75981d19c.r2.dev
# Preferred once custom domain is attached:
# VITE_ASSET_BASE=https://assets.twentyseven.pictures

# Like totals now live on the editor Worker (D1). Leave VITE_LIKES_API empty
# and the client uses VITE_EDITOR_API / `/__editor-api`. Set this only to keep
# talking to the old KV worker.
# VITE_LIKES_API=https://toon-likes.sangalli-marco.workers.dev

# Toon editor Worker (worker/toon-editor). Leave unset for `make dev` — Vite
# proxies /__editor-api → wrangler on :8787 (`make editor-worker` in another
# terminal). Set this only for staging/production builds:
# VITE_EDITOR_API=https://toon-editor.sangalli-marco.workers.dev
# Editor login issues an HS256 JWT signed with JWT_SECRET. Local wrangler reads
# worker/toon-editor/.dev.vars (`make editor-worker` writes one if missing).
# Production: npx wrangler secret put JWT_SECRET  (from worker/toon-editor)
# Local scripts (`npm run import-toon`) sign in with:
# EDITOR_EMAIL=
# EDITOR_PASSWORD=

# Protected local serve (make local / make local-cdn)
PREVIEW_USER=dev
PREVIEW_PASS=
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4173

# ComfyUI (image generation) — key from your ComfyUI account
COMFY_API_KEY=
COMFY_API_URL=https://model-api.runcomfy.net/v1
