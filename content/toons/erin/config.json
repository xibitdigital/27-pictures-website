            "it": "KLANG",
            "de": "KLANG",
            "fr": "KLANG"
          },
          "audio": "assets/sfx/9ed016342ec442dda507806e650cb30f.mp3"
        },
        {
          "x": 0.5,
          "y": 0.48,
          "variant": "burst",
          "tail": "none",
          "size": 24,
          "voice": "narrator",
          "text": {
            "en": "They traded blows for hours. Neither one would fall.",
            "it": "Si colpirono per ore. Nessuno dei due cadeva.",
            "de": "Sie schlugen sich stundenlang. Keiner von beiden fiel.",
            "fr": "Ils échangèrent des coups pendant des heures. Aucun des deux ne tombait."
          },
          "audio": "assets/sfx/1149e493b62b77fd926dadce1c9be80c.mp3"
        }
      ]
    },
    {
      "file": "assets/4c83bc59d71c99d021e07de73ab323c5.webp",
      "words": [
        {
          "x": 0.28,
          "y": 0.07,
          "variant": "credit",
          "tail": "none",
          "size": 24,
          "color": "#111111",
          "voice": "narrator",
          "text": {
            "en": "Returning to the cave…",
            "it": "Tornando alla caverna…",
            "de": "Zurück in der Höhle…",
            "fr": "De retour à la grotte…"
          },
          "audio": "assets/sfx/0ee6d410154e6ff266e3b9a5786d7d5a.mp3"
        },
        {
          "x": 0.3,
          "y": 0.3,
          "size": 26,
          "color": "#111111",
          "angle": -4,
          "stroke": "#ffffff",
          "strokeThickness": 8,
          "text": {
            "en": "TAP… TAP",
            "it": "TAP… TAP",
            "de": "TAP… TAP",
            "fr": "TAP… TAP"
          },
          "audio": "assets/sfx/b598fbd729dcc0f37c04bdc5c8183e36.mp3"
        },
        {
          "x": 0.71,
          "y": 0.6,
          "variant": "bubble",
          "tail": "bottom-left",
          "size": 30,
          "voice": "erin",
          "text": {
            "en": "After I save the child, I'll find you!",
            "it": "Dopo aver salvato la bambina, ti troverò!",
            "de": "Wenn ich das Kind gerettet habe, finde ich dich!",
            "fr": "Une fois l'enfant sauvée, je te retrouverai !"
          },
          "audio": "assets/sfx/e9dd940adfe16990372cffe09c103634.mp3"
        }
      ]
    },
    {
      "file": "assets/5cc55a06fa29a774bd29b1b5707d0228.webp",
      "words": [
        {
          "x": 0.5,
          "y": 0.2,
          "variant": "credit",
          "tail": "none",
          "size": 24,
          "color": "#fff",
          "stroke": "#111111",
          "voice": "narrator",
          "text": {
            "en": "After the Goblin King fled…",
            "it": "Dopo la fuga del Re Goblin…",
            "de": "Nachdem der Goblinkönig geflohen war…",
            "fr": "Après la fuite du Roi Gobelin…"
          }
        },
        {
          "x": 0.3,
          "y": 0.3,
          "size": 26,
          "color": "#111111",
          "angle": -4,
          "stroke": "#ffffff",
          "strokeThickness": 8,
          "text": {
            "en": "DRIP",
            "it": "DRIP",
            "de": "DRIP",
            "fr": "DRIP"
          },
          "audio": "assets/sfx/f47668f98ab9729c89bc1fb643cdd63b.mp3"
        },
        {
          "x": 0.82,
          "y": 0.5,
          "variant": "bubble",
          "tail": "left",
          "size": 30,
          "voice": "erin",
          "text": {
            "en": "But where is she?",
            "it": "Ma lei dov'è?",
            "de": "Aber wo ist sie?",
            "fr": "Mais où est-elle ?"
          },
          "audio": "assets/sfx/98be23f37f6ab36bfc350627b50602c1.mp3"
        }
      ]
    },
    {
      "file": "assets/90b6a919184e94f4e299f9f853a18444.webp",
      "words": [
        {
          "x": 0.72,
          "y": 0.22,
          "variant": "bubble",
          "tail": "bottom",
          "size": 40,
          "voice": "sofia",
          "text": {
            "en": "I'M SAFE NOW!",
            "it": "ORA SONO SALVA!",
            "de": "JETZT BIN ICH IN SICHERHEIT!",
            "fr": "JE SUIS SAUVÉE !"
          },
          "audio": "assets/sfx/dfa9a3ec2f8d819c8501cb5a22fcae5c.mp3"
        }
      ]
    },
    {
      "file": "assets/5fa458b9fffba75c3e08e12d4ff47af0.webp",
      "words": [
        {
          "x": 0.26,
          "y": 0.05,
          "variant": "bubble",
          "tail": "bottom-right",
          "voice": "erin",
          "text": {
            "en": "Hi, are you the lost little girl?",
            "it": "Ciao, sei tu la bambina scomparsa?",
            "de": "Hallo, bist du das vermisste Mädchen?",
            "fr": "Salut, c'est toi la petite fille disparue ?"
          },
          "audio": "assets/sfx/14682b1b02e88239501bb5e6d408f2a4.mp3"
        },
        {
          "x": 0.15,
          "y": 0.18,
          "variant": "bubble",
          "tail": "bottom-right",
          "size": 24,
          "voice": "sofia",
          "text": {
            "en": "Yes!",
            "it": "Sì!",
            "de": "Ja!",
            "fr": "Oui !"
          },
          "audio": "assets/sfx/e0de94c6a6b6a3c7bd5af494850336e1.mp3"
        },
        {
          "x": 0.84,
          "y": 0.105,
          "variant": "bubble",
          "tail": "bottom-left",
          "voice": "erin",
          "text": {
            "en": "Then I'll take you home. Come with me.",
            "it": "Allora ti porto a casa. Vieni con me.",
            "de": "Dann bringe ich dich nach Hause. Komm mit.",
            "fr": "Alors je te ramène chez toi. Viens avec moi."
          },
          "audio": "assets/sfx/a1575a9b0c57d2b13cd5c9a0d72ee95e.mp3"
        },
        {
          "x": 0.41,
          "y": 0.47,
          "variant": "bubble",
          "tail": "bottom-left",
          "size": 25,
          "voice": "sofia",
          "text": {
            "en": "Thank you for saving me from the goblins! I was imprisoned by the guards and you defeated them!",
            "it": "Grazie per avermi salvata dai goblin! Le guardie mi tenevano prigioniera e tu le hai sconfitte!",
            "de": "Danke, dass du mich vor den Goblins gerettet hast! Die Wachen hielten mich gefangen, und du hast sie besiegt!",
            "fr": "Merci de m'avoir sauvée des gobelins ! Les gardes me retenaient prisonnière et tu les as vaincus !"
          },
          "audio": "assets/sfx/55ff13b3e9d575482e92c3e88c8ddd69.mp3"
        },
        {
          "x": 0.61,
          "y": 0.7,
          "variant": "bubble",
          "tail": "bottom-left",
          "size": 20,
          "voice": "sofia",
          "text": {
            "en": "Teach me those moves, please please!",
            "it": "Insegnami quelle mosse, ti prego, ti prego!",
            "de": "Bring mir diese Bewegungen bei, bitte, bitte!",
            "fr": "Apprends-moi ces mouvements, s'il te plaît !"
          },
          "audio": "assets/sfx/69cb8e115c14e9fc85df6140e18f9e2c.mp3"
        },
        {
          "x": 0.87,
          "y": 0.66,
          "variant": "bubble",
          "tail": "bottom",
          "size": 20,
          "voice": "erin",
          "text": {
            "en": "Not now. There's no time.",
            "it": "Non ora. Non c'è tempo.",
            "de": "Nicht jetzt. Wir haben keine Zeit.",
            "fr": "Pas maintenant. Il n'y a pas le temps."
          },
          "audio": "assets/sfx/01bfd09f39a96231f1db64c408f9dd0d.mp3"
        }
      ]
    },
    {
      "file": "assets/bc7cf2e9f4fd6d10d35eba137c08db88.webp",
      "words": [
        {
          "x": 0.25,
          "y": 0.39,
          "variant": "bubble",
          "tail": "bottom-right",
          "voice": "sofia",
          "text": {
            "en": "When I grow up I want to be a warrior like you!",
            "it": "Da grande voglio diventare una guerriera come te!",
            "de": "Wenn ich groß bin, will ich eine Kriegerin wie du werden!",
            "fr": "Quand je serai grande, je veux être une guerrière comme toi !"
          },
          "audio": "assets/sfx/d87a58b656165866f4bd6014508f9fc5.mp3"
        },
        {
          "x": 0.76,
          "y": 0.82,
          "variant": "bubble",
          "tail": "left",
          "voice": "erin",
          "text": {
            "en": "I'll return to that cave… even stronger this time. He won't escape me!",
            "it": "Tornerò in quella caverna… ancora più forte. Non mi sfuggirà!",
            "de": "Ich kehre in diese Höhle zurück… noch stärker. Er entkommt mir nicht!",
            "fr": "Je retournerai dans cette grotte… encore plus forte. Il ne m'échappera pas !"
          },
          "audio": "assets/sfx/9d1cb1cd4644baa079a27cb7009dd87a.mp3"
        }
      ]
    },
