        {
          "x": 0.72,
          "y": 0.38,
          "variant": "bubble",
          "tail": "bottom-left",
          "size": 25,
          "text": {
            "en": "There you are.",
            "it": "Venus. Aspettavo da molto che una porta si aprisse.",
