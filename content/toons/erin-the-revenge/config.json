          "x": 0.82,
          "y": 0.05,
          "variant": "bubble",
          "tail": "bottom-left",
          "size": 30,
          "voice": "venus",
          "text": {
            "en": "I felt your door.",
            "it": "Ho sentito la tua porta.",
