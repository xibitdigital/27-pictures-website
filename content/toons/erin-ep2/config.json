          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Stone hands. Stone wrists.",
            "it": "Mani di pietra. Polsi di pietra.",
            "de": "Steinhände. Steingelenke.",
            "fr": "Mains de pierre. Poignets de pierre."
