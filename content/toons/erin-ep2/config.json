    {
      "file": "assets/874d3cb762df239a8666abc70e1268d4.jpg",
      "words": [
        {
          "x": 0.74,
          "y": 0.06,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Who's holding this up?",
            "it": "Chi la sta tenendo su?",
            "de": "Wer hält das hier oben?",
            "fr": "Qui tient ça en l'air ?"
          },
          "audio": "assets/sfx/90542e538fca3cded0523165d2b58a2c.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-left"
          }
        },
        {
          "x": 0.22,
          "y": 0.38,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Breathe. I have you.",
            "it": "Respira. Ti tengo io.",
            "de": "Atme. Ich habe dich.",
            "fr": "Respire. Je te tiens."
          },
          "audio": "assets/sfx/9b395ccfa86e78e234ee8141b2b6cb37.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        },
        {
          "x": 0.24,
          "y": 0.7,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.32,
          "text": {
            "en": "You could've caught me sooner.",
            "it": "Potevi prendermi prima.",
            "de": "Du hättest mich früher fangen können.",
            "fr": "Tu aurais pu me rattraper plus tôt."
          },
          "audio": "assets/sfx/4acb9b487349e0bcd6f62c022453c22b.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        }
      ]
    },
    {
      "file": "assets/521437fdaaea4a1461f725b790084603.jpg",
      "words": [
        {
          "x": 0.74,
          "y": 0.06,
          "align": "center",
          "size": 26,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.32,
          "text": {
            "en": "Everything here is matter. Even the dark.",
            "it": "Qui è tutto materia. Anche il buio.",
            "de": "Alles hier ist Materie. Auch die Dunkelheit.",
            "fr": "Ici tout est matière. Même le noir."
          },
          "audio": "assets/sfx/ac3ad88ca05255aec0f34cbcce996ef6.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-left"
          }
        },
        {
          "x": 0.76,
          "y": 0.33,
          "align": "center",
          "size": 27,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Big is easy. Small is honest.",
            "it": "Il grande è facile. Il piccolo è onesto.",
            "de": "Groß ist leicht. Klein ist ehrlich.",
            "fr": "Le grand est facile. Le petit est honnête."
          },
          "audio": "assets/sfx/efb1d725fbc66f8e7460cad06b0ad805.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-left"
          }
        },
        {
          "x": 0.22,
          "y": 0.4,
          "align": "center",
          "size": 32,
          "color": "#111111",
          "stroke": "#ffffff",
          "strokeThickness": 8,
          "angle": 5,
          "maxWidth": 0.24,
          "text": {
            "en": "GRRNN",
            "it": "GRRNN",
            "de": "GRRNN",
            "fr": "GRRNN"
          },
          "audio": "assets/sfx/6b79f1e1cb904221237bee555e8ad8af.mp3"
        },
        {
          "x": 0.24,
          "y": 0.63,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.24,
          "text": {
            "en": "Now. Take it.",
            "it": "Ora. Prendilo.",
            "de": "Jetzt. Nimm ihn.",
            "fr": "Maintenant. Prends-le."
          },
          "audio": "assets/sfx/8ce35b195e0cfabf4300d8c0872a9edc.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        },
        {
          "x": 0.18,
          "y": 0.83,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.22,
          "text": {
            "en": "It's warm.",
            "it": "È caldo.",
            "de": "Er ist warm.",
            "fr": "C'est chaud."
          },
          "audio": "assets/sfx/a76bf262fb0de2ab7312f8f31aa6eaa8.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        }
      ]
    },
    {
      "file": "assets/ceca59e0aaffe7393d77a5b45396cece.jpg",
      "words": [
        {
          "x": 0.22,
          "y": 0.07,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "You knew I'd fall.",
            "it": "Sapevi che sarei caduta.",
            "de": "Du wusstest, dass ich falle.",
            "fr": "Tu savais que je tomberais."
          },
          "audio": "assets/sfx/e7d54672c4fda84f0c2f93312b2c8ac9.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        },
        {
          "x": 0.72,
          "y": 0.38,
          "align": "center",
          "size": 25,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.34,
          "text": {
            "en": "Venus. I've been waiting a long time for a door to open.",
            "it": "Venus. Aspettavo da molto che una porta si aprisse.",
            "de": "Venus. Ich habe lange gewartet, dass sich eine Tür öffnet.",
            "fr": "Venus. J'attends depuis longtemps qu'une porte s'ouvre."
          },
          "audio": "assets/sfx/ec996f3b3c6a46eaa57902292d9dc7a1.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-left"
          }
        },
        {
          "x": 0.22,
          "y": 0.71,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Erin. I'm here for a child.",
            "it": "Erin. Sono qui per una bambina.",
            "de": "Erin. Ich bin wegen eines Kindes hier.",
            "fr": "Erin. Je suis là pour une enfant."
          },
          "audio": "assets/sfx/1cf084c89f555cce10e775f5df6058b6.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        }
      ]
    },
    {
      "file": "assets/313de46170f64763cb387e2ea1ccf929.jpg",
      "words": [
        {
          "x": 0.74,
          "y": 0.07,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "They took her through there.",
            "it": "L'hanno portata di là.",
            "de": "Sie haben sie dort hindurchgebracht.",
            "fr": "Ils l'ont emmenée par là."
          },
          "audio": "assets/sfx/5121f39ff1ad7f53d59e146d3d37e509.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-left"
          }
        },
        {
          "x": 0.22,
          "y": 0.56,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Then that's where I'm going.",
            "it": "Allora è lì che vado.",
            "de": "Dann gehe ich dorthin.",
            "fr": "Alors c'est là que je vais."
          },
          "audio": "assets/sfx/7b97eb4543d1d52670eada0ae622a9c8.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
          }
        }
      ]
    },
    {
      "file": "assets/7bd9bab570fcbf28cea206ec9ee89f37.jpg",
      "words": [
        {
          "x": 0.3,
          "y": 0.06,
          "align": "center",
          "size": 27,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "Two now? The King eats twice.",
            "it": "Due, adesso? Il Re mangia due volte.",
            "de": "Jetzt zwei? Der König isst zweimal.",
            "fr": "Deux, maintenant ? Le Roi mange deux fois."
          },
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-left"
          },
          "audio": "assets/sfx/31f1ec29228c0637cd67490bd4ebf172.mp3"
        },
        {
          "x": 0.74,
          "y": 0.1,
          "align": "center",
          "size": 34,
          "color": "#111111",
          "stroke": "#ffffff",
          "strokeThickness": 8,
          "angle": -6,
          "maxWidth": 0.24,
          "text": {
            "en": "GRRRH",
            "it": "GRRRH",
            "de": "GRRRH",
            "fr": "GRRRH"
          },
          "audio": "assets/sfx/d6171bd6a6125ed49e942ee1576e6794.mp3"
