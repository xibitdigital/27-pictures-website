          "align": "center",
          "size": 40,
          "variant": "burst",
          "color": "#111111",
          "maxWidth": 0.24,
          "text": {
            "en": "LET GO!",
            "it": "LASCIAMI!",
            "de": "LOSLASSEN!",
            "fr": "LÂCHE-MOI !"
