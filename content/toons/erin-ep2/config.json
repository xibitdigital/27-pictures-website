        },
        {
          "x": 0.22,
          "y": 0.72,
          "align": "center",
          "size": 30,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.3,
          "text": {
            "en": "I only need one hand.",
            "it": "Mi basta una mano.",
            "de": "Mir reicht eine Hand.",
            "fr": "Une seule main me suffit."
          },
          "audio": "assets/sfx/2f248804cd979abd9a5aabef12123df0.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom-right"
