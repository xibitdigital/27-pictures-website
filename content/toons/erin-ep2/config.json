        {
          "x": 0.72,
          "y": 0.39,
          "align": "center",
          "size": 26,
          "variant": "bubble",
          "color": "#111111",
          "maxWidth": 0.32,
          "text": {
            "en": "Behind you. Don't turn — I'll count.",
            "it": "Dietro di te. Non voltarti — conto io.",
            "de": "Hinter dir. Dreh dich nicht um — ich zähle.",
            "fr": "Derrière toi. Ne te retourne pas — je compte."
          },
          "audio": "assets/sfx/15634f31670cc3e25d5285f326edcb86.mp3",
          "bubble": {
            "opacity": 0.75,
            "strokeWidth": 5,
            "tail": "bottom"
