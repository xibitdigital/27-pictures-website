# dependencies
node_modules

# testing
/coverage

# production
/build
/export
/dist

# generated files
*.pdf

# Locale HTML generated from src/toons/index.html + src/site/locales/
/src/it/
/src/de/
/src/fr/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# watermark script backups (originals before bake)
.watermark-backup/

# Toon / card media live on R2 (VITE_ASSET_BASE). Keep local copies untracked.
# Structure: public/toons/*/assets/, public/toons/assets/, public/card-art/
public/toons/**/assets/**
!public/toons/**/assets/.gitkeep
public/card-art/**
!public/card-art/.gitkeep

npm-debug.log*
*.log
dist

# Local CDN image backups (not in git)
cdn-backup/

# Local WebP conversion staging (npm run convert-plates)
converted/

# Local plate restyle staging (npm run restyle-plates)
restyled/
worker/likes/.wrangler/

# Generation references (character sheets etc.) — inputs, not site assets
references/
