{
  "name": "27-pictures-website",
  "private": true,
  "scripts": {
    "generate-qr": "node scripts/generate-qr.js",
    "generate-qr-image": "node scripts/generate-qr-image.js",
    "watermark": "bash scripts/watermark-images.sh",
    "add-image": "node scripts/add-toon-image.js",
    "convert-plates": "node scripts/convert-toon-plates.js",
    "restyle-plates": "python3 scripts/restyle-toon-plates.py",
    "swap-page": "node scripts/swap-toon-page.js",
    "comfy-page": "python3 scripts/build-comfy-plate.py",
    "hash-toon-config": "node scripts/hash-toon-config.js",
    "publish-toon-config": "node scripts/publish-toon-config.js",
    "prune-pages-deployments": "node scripts/prune-pages-deployments.js",
    "ship-toon": "node scripts/ship-toon.js",
    "normalise-audio": "python3 scripts/normalise-toon-audio.py",
    "download-toon-config": "node scripts/download-toon-config.js",
    "create-assets-bucket": "node scripts/upload-r2-assets.js --create-bucket",
    "upload-assets": "node scripts/upload-r2-assets.js",
    "upload-assets:dry": "node scripts/upload-r2-assets.js --dry-run",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "local": "node scripts/serve-protected.js",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,html,json}\" \"public/**/*.{css,html,js,json}\" \"vite/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css,html,json}\" \"public/**/*.{css,html,js,json}\" \"vite/**/*.ts\"",
    "check": "npm test && npm run build",
    "backup-cdn": "node scripts/backup-cdn-assets.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.86.0"
  }
}
