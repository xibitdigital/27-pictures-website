/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # media-src includes data: for FlipFrame silent HTMLAudio unlock (iOS Safari
  # needs a real play() on a data-URI wav during the OK gesture).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-src https://www.youtube.com https://challenges.cloudflare.com; img-src 'self' data: blob: https://i.ytimg.com https://assets.twentyseven.pictures https://pub-e60c8fa8eea343fbac708bf75981d19c.r2.dev https://toon-editor.sangalli-marco.workers.dev; media-src 'self' data: https://assets.twentyseven.pictures https://pub-e60c8fa8eea343fbac708bf75981d19c.r2.dev; connect-src 'self' https://contact-form.sangalli-marco.workers.dev https://toon-likes.sangalli-marco.workers.dev https://toon-editor.sangalli-marco.workers.dev https://assets.twentyseven.pictures https://pub-e60c8fa8eea343fbac708bf75981d19c.r2.dev https://cloudflareinsights.com; object-src 'none'; base-uri 'self'

# Hashed filenames only — see vite/plugins/hashedCss.ts. `immutable` on a
# stable name whose body changes lets a CDN freeze a stale copy for a year.
/styles.*.css
  Cache-Control: public, max-age=31536000, immutable

/toons/reader-shared.*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed logo (bytes change => new name + update this rule; see the
# hashedCss.ts postmortem for why a stable immutable path must never change body)
/logo.1a83b92ec2.png
  Cache-Control: public, max-age=31536000, immutable

/logosquare.png
  Cache-Control: public, max-age=31536000, immutable

/the-red-smile.jpg
